# Database
DATABASE_URL="postgresql://user:password@localhost:5432/teen_patti?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_REFRESH_SECRET="your-refresh-secret-change-this"
REFERRAL_HASH_SECRET="generate-a-separate-32-byte-secret"
JWT_EXPIRY="7d"
JWT_REFRESH_EXPIRY="30d"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Server
PORT=3001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"
PUBLIC_APP_URL="http://localhost:5173"
TRUST_PROXY=1
APP_VERSION="dev"
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.05

# Purchases are off by default. Do not enable before legal/platform review.
PURCHASES_ENABLED=false
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Game Config
DEFAULT_CHIPS=10000
MIN_BUY_IN=100
MAX_BUY_IN=1000000
TURN_TIMEOUT_SECONDS=30
MAX_PLAYERS_PER_TABLE=9
