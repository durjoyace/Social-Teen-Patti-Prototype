{
  "expo": {
    "name": "Social Teen Patti",
    "slug": "social-teen-patti",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "teenpatti",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.battlegreen.socialteenpatti",
      "backgroundColor": "#0a0a0a",
      "associatedDomains": ["applinks:social-teen-patti.vercel.app"]
    },
    "android": {
      "package": "com.battlegreen.socialteenpatti",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "social-teen-patti.vercel.app", "pathPrefix": "/invite" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "apiUrl": "http://localhost:3001/api",
      "socketUrl": "http://localhost:3001",
      "appUrl": "https://social-teen-patti.vercel.app"
    }
  }
}
