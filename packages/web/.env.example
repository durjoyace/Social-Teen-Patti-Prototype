# Backend
VITE_API_URL=http://localhost:3001/api
VITE_SOCKET_URL=http://localhost:3001

# Set these to explicit HTTPS endpoints in every production/preview deployment.

# Sentry Error Tracking (get DSN from sentry.io)
VITE_SENTRY_DSN=

# Analytics (get token from mixpanel.com)
VITE_MIXPANEL_TOKEN=
VITE_ANALYTICS_ENABLED=true

# Razorpay Payments (get key from razorpay.com)
VITE_RAZORPAY_KEY=
VITE_PURCHASES_ENABLED=false

# Push Notifications (generate VAPID keys with web-push)
VITE_VAPID_PUBLIC_KEY=

# App Version (use the release commit SHA in production)
VITE_APP_VERSION=dev
