# Backend
VITE_API_URL=http://localhost:3001/api
VITE_SOCKET_URL=http://localhost:3001

# Sentry Error Tracking (get DSN from sentry.io)
VITE_SENTRY_DSN=

# Analytics (get token from mixpanel.com)
VITE_MIXPANEL_TOKEN=

# Razorpay Payments (get key from razorpay.com)
VITE_RAZORPAY_KEY=

# Push Notifications (generate VAPID keys with web-push)
VITE_VAPID_PUBLIC_KEY=

# App Version
VITE_APP_VERSION=1.0.0
